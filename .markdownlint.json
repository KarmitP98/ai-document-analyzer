{
    "MD013": false,
    "MD029": false,
    "MD034": false,
    "code-block-style": {
      "style": "fenced"
    },
    "code-fence-style": {
      "style": "backtick"
    },
    "emphasis-style": {
      "style": "asterisk"
    },
    "heading-style": {
      "style": "atx"
    },
    "hr-style": {
      "style": "---"
    },
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "proper-names": {
      "code_blocks": false,
      "names": [
        "Cake.Markdownlint",
        "CommonMark",
        "JavaScript",
        "Markdown",
        "markdown-it",
        "markdownlint",
        "Node.js"
      ]
    },
    "strong-style": {
      "style": "asterisk"
    },
    "ul-style": {
      "style": "dash"
    }
  }